From 3b7a52df5a78a77e3aeb16ed536056694819798e Mon Sep 17 00:00:00 2001
From: Jean-Philippe Brucker <jean-philippe@linaro.org>
Date: Fri, 3 May 2024 15:48:49 +0100
Subject: [PATCH] package: Add recipe for CCA realm-token

Signed-off-by: Mathieu Poirier <mathieu.poirier@linaro.org>
Signed-off-by: Jean-Philippe Brucker <jean-philippe@linaro.org>
---
 package/Config.in                  |  1 +
 package/realm-token/Config.in      | 19 +++++++++++++++
 package/realm-token/realm-token.mk | 37 ++++++++++++++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 package/realm-token/Config.in
 create mode 100644 package/realm-token/realm-token.mk

diff --git a/package/Config.in b/package/Config.in
index 8daa1d37..a7f4c5f9 100644
--- a/package/Config.in
+++ b/package/Config.in
@@ -2335,6 +2335,7 @@ menu "Miscellaneous"
 	source "package/proj/Config.in"
 	source "package/qemu/Config.in"
 	source "package/qpdf/Config.in"
+	source "package/realm-token/Config.in"
 	source "package/rtl_433/Config.in"
 	source "package/shared-mime-info/Config.in"
 	source "package/sunwait/Config.in"
diff --git a/package/realm-token/Config.in b/package/realm-token/Config.in
new file mode 100644
index 00000000..b9ee18a0
--- /dev/null
+++ b/package/realm-token/Config.in
@@ -0,0 +1,19 @@
+config BR2_PACKAGE_REALM_TOKEN
+	bool "realm-token"
+	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
+	select BR2_PACKAGE_HOST_RUSTC
+	select BR2_PACKAGE_HOST_PKGCONF
+	select BR2_PACKAGE_OPENSSL
+	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
+	select BR2_PACKAGE_BUSYBOX_SHOW_OTHERS # for bash
+	select BR2_PACKAGE_BASH # for gen-run-vmm.sh
+	help
+	  Given a VM configuration and the payload to run in the Realm,
+	  this tool calculates the Realm Initial and Extended
+	  Measurements, needed for CCA attestation.  This is aprototype,
+	  to experiment with Realm attestation and find out what
+	  can/should be standardized.
+
+	  https://git.codelinaro.org/linaro/dcap/realm-token
+	  
+
diff --git a/package/realm-token/realm-token.mk b/package/realm-token/realm-token.mk
new file mode 100644
index 00000000..1a529ca0
--- /dev/null
+++ b/package/realm-token/realm-token.mk
@@ -0,0 +1,37 @@
+################################################################################
+#
+# realm-token 
+#
+################################################################################
+
+REALM_TOKEN_VERSION = main
+REALM_TOKEN_SITE = https://git.codelinaro.org/linaro/dcap/realm-token.git
+
+REALM_TOKEN_SITE_METHOD = git
+REALM_TOKEN_LICENSE = Apache-2.0 or MIT
+REALM_TOKEN_LICENSE_FILES = LICENSE-APACHE LICENSE-MIT
+
+define REALM_TOKEN_INSTALL_TARGET_CMDS
+	cd $($(PKG)_SRCDIR) && \
+		$(TARGET_MAKE_ENV) \
+		$(TARGET_CONFIGURE_OPTS) \
+		$(PKG_CARGO_ENV) \
+		$(REALM_TOKEN_CARGO_ENV) \
+		cargo install \
+			--offline \
+			--root $(TARGET_DIR)/usr/ \
+			--bins \
+			--path ./ \
+			--force \
+			--locked \
+			-Z target-applies-to-host \
+			$(REALM_TOKEN_CARGO_INSTALL_OPTS) && \
+		install -Dt $(TARGET_DIR)/usr/share/realm-token/configs/ configs/* && \
+		install -Dt $(TARGET_DIR)/usr/share/realm-token/ scripts/gen-run-vmm.cfg && \
+		install -Dt $(TARGET_DIR)/usr/bin/ scripts/gen-run-vmm.sh
+endef
+
+# Depends on OpenSSL lib, so pkg-config is used during build
+REALM_TOKEN_DEPENDENCIES += host-pkgconf openssl
+
+$(eval $(cargo-package))
-- 
2.45.2

