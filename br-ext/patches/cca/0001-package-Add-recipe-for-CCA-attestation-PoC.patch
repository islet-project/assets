From ffd08c93faaea815dec70aba0d71df98bd93bf41 Mon Sep 17 00:00:00 2001
From: Mathieu Poirier <mathieu.poirier@linaro.org>
Date: Tue, 21 May 2024 13:51:50 -0600
Subject: [PATCH] package: Add recipe for CCA attestation PoC

Signed-off-by: Mathieu Poirier <mathieu.poirier@linaro.org>
---
 package/Config.in                             |  1 +
 package/cca-workload-attestation/Config.in    | 10 ++++++++++
 .../cca-workload-attestation.mk               | 19 +++++++++++++++++++
 3 files changed, 30 insertions(+)
 create mode 100644 package/cca-workload-attestation/Config.in
 create mode 100644 package/cca-workload-attestation/cca-workload-attestation.mk

diff --git a/package/Config.in b/package/Config.in
index 33039331f7dc..3324cdd6c0c4 100644
--- a/package/Config.in
+++ b/package/Config.in
@@ -2299,6 +2299,7 @@ menu "Miscellaneous"
 	source "package/bc/Config.in"
 	source "package/bitcoin/Config.in"
 	source "package/clamav/Config.in"
+	source "package/cca-workload-attestation/Config.in"
 	source "package/collectd/Config.in"
 	source "package/collectl/Config.in"
 	source "package/domoticz/Config.in"
diff --git a/package/cca-workload-attestation/Config.in b/package/cca-workload-attestation/Config.in
new file mode 100644
index 000000000000..733ff3117b05
--- /dev/null
+++ b/package/cca-workload-attestation/Config.in
@@ -0,0 +1,10 @@
+config BR2_PACKAGE_CCA_WORKLOAD_ATTESTATION
+	bool "CCA Workload Attestation PoC"
+	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
+	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
+	help
+	  A proof-of-concept, self-contained executable that
+	  demonstrates the use of CCA attestation in a number
+	  of representative scenarios.
+
+	  https://git.codelinaro.org/linaro/dcap/cca-demos/cca-workload-attestation-poc
diff --git a/package/cca-workload-attestation/cca-workload-attestation.mk b/package/cca-workload-attestation/cca-workload-attestation.mk
new file mode 100644
index 000000000000..ff413a142e1e
--- /dev/null
+++ b/package/cca-workload-attestation/cca-workload-attestation.mk
@@ -0,0 +1,19 @@
+################################################################################
+#
+# CCA Workload Attestation PoC
+#
+################################################################################
+
+CCA_WORKLOAD_ATTESTATION_VERSION = clo/main
+CCA_WORKLOAD_ATTESTATION_SITE = https://git.codelinaro.org/linaro/dcap/cca-demos/cca-workload-attestation-poc.git
+CCA_WORKLOAD_ATTESTATION_SITE_METHOD = git
+CCA_WORKLOAD_ATTESTATION_LICENSE = BSD 3-Clause
+CCA_WORKLOAD_ATTESTATION_LICENSE_FILES = LICENSE
+
+CCA_WORKLOAD_ATTESTATION_GOMOD = git.codelinaro.org/linaro/dcap/cca-demos/cca-workload-attestation-poc
+
+# Uncomment the next two lines for a statically linked application
+#CCA_WORKLOAD_ATTESTATION_GO_ENV = CGO_ENABLED=0 GOARCH=arm64 GOOS=linux
+#CCA_WORKLOAD_ATTESTATION_LDFLAGS = -s -w
+
+$(eval $(golang-package))
-- 
2.34.1

